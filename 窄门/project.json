    },
    {
      "func": "引入书",
      "desc": "教堂石墙上极高极窄的一扇侧门，冷光从门缝切成一道细长亮带，四周沉在深蓝黑里"
    },
    {
      "func": "情绪高点",
      "desc": "深蓝暮色铁栅门，一只手只露指尖握在铁条上，门另一侧空着，远处一扇亮着冷光的窗"
    },
    {
      "func": "转折",
      "desc": "空的疗养院病房，窄铁床白床单铺得极平、枕头一个浅凹痕，白纱帘被风吹起"
    },
    {
      "func": "收尾",
      "desc": "深夜木桌摊开旧布面日记，纸页空白，手指停在页边，铜盘里快燃尽的白蜡烛"
    }
  ]
