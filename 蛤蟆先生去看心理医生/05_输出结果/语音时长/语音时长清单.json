          "end_sec": 10.88,
          "abs_start_sec": 14.675,
          "abs_end_sec": 15.815,
          "source": "由音频反推",
          "char_count": 8,
          "char_per_sec": 7.02
        },
        {
          "seq": 9,
          "text": "用一只蛤蟆，",
