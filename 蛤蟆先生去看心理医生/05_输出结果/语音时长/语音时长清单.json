      "lines": [
        {
          "seq": 1,
          "text": "你有没有过这种感觉：",
          "start_sec": 0.0,
          "end_sec": 1.36,
          "abs_start_sec": 4.935,
          "abs_end_sec": 6.295,
          "source": "由音频反推",
          "char_count": 9,
          "char_per_sec": 6.62
        },
        {
          "seq": 2,
          "text": "什么都没做错，",
          "start_sec": 1.59,
          "end_sec": 2.62,
          "abs_start_sec": 6.525,
          "abs_end_sec": 7.555,
          "source": "由音频反推",
          "char_count": 6,
          "char_per_sec": 5.83
        },
        {
          "seq": 3,
          "text": "就是提不起劲。",
          "start_sec": 2.86,
          "end_sec": 3.88,
          "abs_start_sec": 7.795,
          "abs_end_sec": 8.815,
          "source": "由音频反推",
          "char_count": 6,
          "char_per_sec": 5.88
        },
        {
          "seq": 4,
          "text": "别人问你怎么样，",
          "start_sec": 4.29,
          "end_sec": 5.26,
          "abs_start_sec": 9.225,
          "abs_end_sec": 10.195,
          "source": "由音频反推",
          "char_count": 7,
          "char_per_sec": 7.22
        },
        {
          "seq": 5,
          "text": "你说“还行”。",
          "start_sec": 5.48,
          "end_sec": 6.26,
          "abs_start_sec": 10.415,
          "abs_end_sec": 11.195,
          "source": "由音频反推",
          "char_count": 4,
          "char_per_sec": 5.13
        },
        {
          "seq": 6,
          "text": "其实心里早就空了。",
          "start_sec": 6.63,
          "end_sec": 8.37,
          "abs_start_sec": 11.565,
          "abs_end_sec": 13.305,
          "source": "由音频反推",
          "char_count": 8,
          "char_per_sec": 4.6
        },
        {
          "seq": 7,
          "text": "一九二三年，",
          "start_sec": 8.73,
          "end_sec": 9.55,
          "abs_start_sec": 13.665,
          "abs_end_sec": 14.485,
          "source": "由音频反推",
          "char_count": 5,
          "char_per_sec": 6.1
        },
        {
          "seq": 8,
          "text": "英国一位心理医生，",
