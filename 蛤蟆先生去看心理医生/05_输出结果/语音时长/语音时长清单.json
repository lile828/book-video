          "abs_start_sec": 25.585,
          "abs_end_sec": 27.285,
          "source": "由音频反推",
          "char_count": 10,
          "char_per_sec": 5.88
        },
        {
          "seq": 18,
          "text": "从没走进过“成人”。",
          "start_sec": 22.53,
          "end_sec": 23.85,
          "abs_start_sec": 27.465,
          "abs_end_sec": 28.785,
          "source": "由音频反推",
          "char_count": 7,
          "char_per_sec": 5.3
        },
        {
          "seq": 19,
          "text": "更扎心的是：",
          "start_sec": 24.24,
