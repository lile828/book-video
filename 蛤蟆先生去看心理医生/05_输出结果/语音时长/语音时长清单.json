          "abs_end_sec": 23.155,
          "source": "由音频反推",
          "char_count": 2,
          "char_per_sec": 4.55
        },
        {
          "seq": 15,
          "text": "成人。",
          "start_sec": 18.4,
          "end_sec": 18.82,
          "abs_start_sec": 23.335,
          "abs_end_sec": 23.755,
          "source": "由音频反推",
          "char_count": 2,
          "char_per_sec": 4.76
        },
        {
          "seq": 16,
          "text": "很多人一辈子，",
          "start_sec": 19.23,
          "end_sec": 20.41,
          "abs_start_sec": 24.165,
          "abs_end_sec": 25.345,
          "source": "由音频反推",
          "char_count": 6,
          "char_per_sec": 5.08
        },
        {
          "seq": 17,
          "text": "在儿童和父母之间来回，",
