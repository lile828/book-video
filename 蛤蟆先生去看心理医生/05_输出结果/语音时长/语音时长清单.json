          "abs_end_sec": 17.055,
          "source": "由音频反推",
          "char_count": 5,
          "char_per_sec": 4.76
        },
        {
          "seq": 10,
          "text": "讲清了抑郁是怎么来的。",
          "start_sec": 12.41,
          "end_sec": 14.02,
          "abs_start_sec": 17.345,
          "abs_end_sec": 18.955,
          "source": "由音频反推",
          "char_count": 10,
          "char_per_sec": 6.21
        },
        {
          "seq": 11,
          "text": "书里说，",
          "start_sec": 14.41,
          "end_sec": 15.04,
          "abs_start_sec": 19.345,
          "abs_end_sec": 19.975,
          "source": "由音频反推",
          "char_count": 3,
          "char_per_sec": 4.76
        },
        {
          "seq": 12,
          "text": "人的情绪有三种状态：",
          "start_sec": 15.26,
          "end_sec": 16.89,
          "abs_start_sec": 20.195,
          "abs_end_sec": 21.825,
          "source": "由音频反推",
          "char_count": 9,
          "char_per_sec": 5.52
        },
        {
          "seq": 13,
          "text": "儿童，",
          "start_sec": 17.1,
          "end_sec": 17.57,
          "abs_start_sec": 22.035,
          "abs_end_sec": 22.505,
          "source": "由音频反推",
          "char_count": 2,
          "char_per_sec": 4.26
        },
        {
          "seq": 14,
          "text": "父母，",
          "start_sec": 17.78,
          "end_sec": 18.22,
