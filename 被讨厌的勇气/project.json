    },
    {
      "func": "引入书",
      "desc": "极暗灰泥墙，一束窄硬光从左上斜切，投出一高一矮两个拉长的影子（无面部细节），下方露出一级带苔痕石阶"
    },
    {
      "func": "观点1",
      "desc": "黄铜钥匙静置黑色石材台面，齿边被冷光勾出白亮细线，背景纯黑，向右投短而硬的影子"
    },
    {
      "func": "观点2",
      "desc": "紧闭旧木门，门缝下透出一线细长白光，球形铜把手有氧化暗斑，门框边缘墙皮剥落，两侧全暗"
    },
    {
      "func": "反转",
      "desc": "一个人背对镜头站在天台边缘，外套被风吹起，剪影无面部，远处冷蓝城市天际线灯火稀疏，下部为水泥地"
    },
    {
      "func": "收尾",
      "desc": "纯黑桌面上摊开的书被顶光打出明亮光斑，书页边缘泛白四周迅速衰减全黑，旁边一支合上的黑色钢笔"
    }
  ]
