    {
      "id": "03_正文",
      "title": "正文",
      "file": "03_正文.wav",
      "path": "03_成片素材/音频/自在独行/03_正文.wav",
      "format": "wav",
      "sample_rate": 40000,
      "channels": 2,
      "char_count": 249,
      "duration_sec": 53.205,
      "duration_source": "逐行合成（文件实测）",
      "speech_rate": 4.68,
      "lines": [
        {
          "seq": 1,
          "text": "这本书出版那年，",
          "start_sec": 0.0,
          "end_sec": 1.1,
          "abs_start_sec": 2.305,
          "abs_end_sec": 3.405,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 2,
          "text": "他六十四岁。",
          "start_sec": 1.32,
          "end_sec": 2.12,
          "abs_start_sec": 3.625,
          "abs_end_sec": 4.425,
          "source": "逐行合成",
          "char_count": 5,
          "char_per_sec": 6.25
        },
        {
          "seq": 3,
          "text": "陕西丹凤人，",
          "start_sec": 2.52,
          "end_sec": 3.32,
          "abs_start_sec": 4.825,
          "abs_end_sec": 5.625,
          "source": "逐行合成",
          "char_count": 5,
          "char_per_sec": 6.25
        },
        {
          "seq": 4,
          "text": "在西安住了大半辈子。",
          "start_sec": 3.54,
          "end_sec": 5.04,
          "abs_start_sec": 5.845,
          "abs_end_sec": 7.345,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.0
        },
        {
          "seq": 5,
          "text": "他最怕有人敲门。",
          "start_sec": 5.44,
          "end_sec": 6.54,
          "abs_start_sec": 7.745,
          "abs_end_sec": 8.845,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 6,
          "text": "书里七十多篇，",
          "start_sec": 6.94,
          "end_sec": 7.94,
          "abs_start_sec": 9.245,
          "abs_end_sec": 10.245,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.0
        },
        {
          "seq": 7,
          "text": "写的都是小东西。",
          "start_sec": 8.16,
          "end_sec": 9.26,
          "abs_start_sec": 10.465,
          "abs_end_sec": 11.565,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 8,
          "text": "最出名的一篇，叫丑石。",
          "start_sec": 9.66,
          "end_sec": 11.16,
          "abs_start_sec": 11.965,
          "abs_end_sec": 13.465,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.0
        },
        {
          "seq": 9,
          "text": "他家门前有块石头，",
          "start_sec": 11.56,
          "end_sec": 12.84,
          "abs_start_sec": 13.865,
          "abs_end_sec": 15.145,
          "source": "逐行合成",
          "char_count": 8,
          "char_per_sec": 6.25
        },
        {
          "seq": 10,
          "text": "黑黝黝的，",
          "start_sec": 13.06,
          "end_sec": 13.66,
          "abs_start_sec": 15.365,
          "abs_end_sec": 15.965,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 6.67
        },
        {
          "seq": 11,
          "text": "牛一样趴在那里。",
          "start_sec": 13.88,
          "end_sec": 14.98,
          "abs_start_sec": 16.185,
          "abs_end_sec": 17.285,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 12,
          "text": "奶奶嫌它碍事，",
          "start_sec": 15.38,
          "end_sec": 16.38,
          "abs_start_sec": 17.685,
          "abs_end_sec": 18.685,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.0
        },
        {
          "seq": 13,
          "text": "伯父盖房没用它，",
          "start_sec": 16.6,
          "end_sec": 17.7,
          "abs_start_sec": 18.905,
          "abs_end_sec": 20.005,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 14,
          "text": "石匠摸了摸，",
          "start_sec": 17.92,
          "end_sec": 18.72,
          "abs_start_sec": 20.225,
          "abs_end_sec": 21.025,
          "source": "逐行合成",
          "char_count": 5,
          "char_per_sec": 6.25
        },
        {
          "seq": 15,
          "text": "也摇头。",
          "start_sec": 18.94,
          "end_sec": 19.54,
          "abs_start_sec": 21.245,
          "abs_end_sec": 21.845,
          "source": "逐行合成",
          "char_count": 3,
          "char_per_sec": 5.0
        },
        {
          "seq": 16,
          "text": "有一天，",
          "start_sec": 19.94,
          "end_sec": 20.585,
          "abs_start_sec": 22.245,
          "abs_end_sec": 22.89,
          "source": "逐行合成",
          "char_count": 3,
          "char_per_sec": 4.65
        },
        {
          "seq": 17,
          "text": "村里来了个天文学家。",
          "start_sec": 20.805,
          "end_sec": 22.305,
          "abs_start_sec": 23.11,
          "abs_end_sec": 24.61,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.0
        },
        {
          "seq": 18,
          "text": "他在石头前站住，",
          "start_sec": 22.705,
          "end_sec": 23.905,
          "abs_start_sec": 25.01,
          "abs_end_sec": 26.21,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 5.83
        },
        {
          "seq": 19,
          "text": "看了一眼就再没走。",
          "start_sec": 24.125,
          "end_sec": 25.76,
          "abs_start_sec": 26.43,
          "abs_end_sec": 28.065,
          "source": "逐行合成",
          "char_count": 8,
          "char_per_sec": 4.89
        },
        {
          "seq": 20,
          "text": "来人说，这是陨石。",
          "start_sec": 26.16,
          "end_sec": 27.26,
          "abs_start_sec": 28.465,
          "abs_end_sec": 29.565,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 21,
          "text": "从天上落下来，",
          "start_sec": 27.66,
          "end_sec": 28.635,
          "abs_start_sec": 29.965,
          "abs_end_sec": 30.94,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.15
        },
        {
          "seq": 22,
          "text": "已经二三百年。",
          "start_sec": 28.855,
          "end_sec": 29.75,
          "abs_start_sec": 31.16,
          "abs_end_sec": 32.055,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.7
        },
        {
          "seq": 23,
          "text": "一院子人都愣了。",
          "start_sec": 30.15,
          "end_sec": 31.25,
          "abs_start_sec": 32.455,
          "abs_end_sec": 33.555,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 24,
          "text": "原来它补过天，",
          "start_sec": 31.65,
          "end_sec": 32.65,
          "abs_start_sec": 33.955,
          "abs_end_sec": 34.955,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.0
        },
        {
          "seq": 25,
          "text": "原来它在天上发过热。",
          "start_sec": 32.87,
          "end_sec": 34.325,
          "abs_start_sec": 35.175,
          "abs_end_sec": 36.63,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.19
        },
        {
          "seq": 26,
          "text": "它落下来，",
          "start_sec": 34.725,
          "end_sec": 35.325,
          "abs_start_sec": 37.03,
          "abs_end_sec": 37.63,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 6.67
        },
        {
          "seq": 27,
          "text": "在荒草里躺了几百年。",
          "start_sec": 35.545,
          "end_sec": 37.045,
          "abs_start_sec": 37.85,
          "abs_end_sec": 39.35,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.0
        },
        {
          "seq": 28,
          "text": "天文学家说，",
          "start_sec": 37.445,
          "end_sec": 38.245,
          "abs_start_sec": 39.75,
          "abs_end_sec": 40.55,
          "source": "逐行合成",
          "char_count": 5,
          "char_per_sec": 6.25
        },
        {
          "seq": 29,
          "text": "丑到极处，",
          "start_sec": 38.465,
          "end_sec": 39.37,
          "abs_start_sec": 40.77,
          "abs_end_sec": 41.675,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 4.42
        },
        {
          "seq": 30,
          "text": "便是美到极处。",
          "start_sec": 39.59,
          "end_sec": 40.59,
          "abs_start_sec": 41.895,
          "abs_end_sec": 42.895,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 6.0
        },
        {
          "seq": 31,
          "text": "贾平凹说，",
          "start_sec": 40.99,
          "end_sec": 41.59,
          "abs_start_sec": 43.295,
          "abs_end_sec": 43.895,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 6.67
        },
        {
          "seq": 32,
          "text": "他这才懂，",
          "start_sec": 41.81,
          "end_sec": 42.41,
          "abs_start_sec": 44.115,
          "abs_end_sec": 44.715,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 6.67
        },
        {
          "seq": 33,
          "text": "一块石头，",
          "start_sec": 42.63,
          "end_sec": 43.23,
          "abs_start_sec": 44.935,
          "abs_end_sec": 45.535,
          "source": "逐行合成",
          "char_count": 4,
          "char_per_sec": 6.67
        },
        {
          "seq": 34,
          "text": "可以忍受误解那么久。",
          "start_sec": 43.45,
          "end_sec": 44.915,
          "abs_start_sec": 45.755,
          "abs_end_sec": 47.22,
          "source": "逐行合成",
          "char_count": 9,
          "char_per_sec": 6.14
        },
        {
          "seq": 35,
          "text": "这本书不劝你合群。",
          "start_sec": 45.315,
          "end_sec": 46.51,
          "abs_start_sec": 47.62,
          "abs_end_sec": 48.815,
          "source": "逐行合成",
          "char_count": 8,
          "char_per_sec": 6.69
        },
        {
          "seq": 36,
          "text": "它只说，",
          "start_sec": 46.91,
          "end_sec": 47.41,
          "abs_start_sec": 49.215,
          "abs_end_sec": 49.715,
          "source": "逐行合成",
          "char_count": 3,
          "char_per_sec": 6.0
        },
        {
          "seq": 37,
          "text": "一个人待着，",
          "start_sec": 47.63,
          "end_sec": 48.335,
          "abs_start_sec": 49.935,
          "abs_end_sec": 50.64,
          "source": "逐行合成",
          "char_count": 5,
          "char_per_sec": 7.09
        },
        {
          "seq": 38,
          "text": "才听得见自己。",
          "start_sec": 48.555,
          "end_sec": 50.055,
          "abs_start_sec": 50.86,
          "abs_end_sec": 52.36,
          "source": "逐行合成",
          "char_count": 6,
          "char_per_sec": 4.0
        },
        {
          "seq": 39,
          "text": "读完你会想关灯，",
          "start_sec": 50.455,
          "end_sec": 51.555,
          "abs_start_sec": 52.76,
          "abs_end_sec": 53.86,
          "source": "逐行合成",
          "char_count": 7,
          "char_per_sec": 6.36
        },
        {
          "seq": 40,
          "text": "在黑暗里坐一会儿。",
          "start_sec": 51.775,
          "end_sec": 53.055,
          "abs_start_sec": 54.08,
          "abs_end_sec": 55.36,
          "source": "逐行合成",
          "char_count": 8,
          "char_per_sec": 6.25
        }
      ]
    }
  ]
}